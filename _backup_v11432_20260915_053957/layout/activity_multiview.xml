<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/multiContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginBottom="70dp">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="#1A1A1A">
                <androidx.media3.ui.PlayerView android:id="@+id/player1" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit" />
                <ImageView android:id="@+id/audioBadge1" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|start" android:layout_margin="6dp" android:src="@drawable/ic_unmute_w" android:visibility="gone" android:background="#80000000" android:padding="3dp" />
                <ImageButton android:id="@+id/close1" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:src="@drawable/ic_close_w" android:background="#80000000" android:padding="4dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#80000000" android:padding="4dp" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="#1A1A1A">
                <androidx.media3.ui.PlayerView android:id="@+id/player2" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit" />
                <ImageView android:id="@+id/audioBadge2" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|start" android:layout_margin="6dp" android:src="@drawable/ic_unmute_w" android:visibility="gone" android:background="#80000000" android:padding="3dp" />
                <ImageButton android:id="@+id/close2" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:src="@drawable/ic_close_w" android:background="#80000000" android:padding="4dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#80000000" android:padding="4dp" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="#1A1A1A">
                <androidx.media3.ui.PlayerView android:id="@+id/player3" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit" />
                <ImageView android:id="@+id/audioBadge3" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|start" android:layout_margin="6dp" android:src="@drawable/ic_unmute_w" android:visibility="gone" android:background="#80000000" android:padding="3dp" />
                <ImageButton android:id="@+id/close3" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:src="@drawable/ic_close_w" android:background="#80000000" android:padding="4dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/title3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#80000000" android:padding="4dp" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            </FrameLayout>

            <FrameLayout android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="#1A1A1A">
                <androidx.media3.ui.PlayerView android:id="@+id/player4" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="fit" />
                <ImageView android:id="@+id/audioBadge4" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="top|start" android:layout_margin="6dp" android:src="@drawable/ic_unmute_w" android:visibility="gone" android:background="#80000000" android:padding="3dp" />
                <ImageButton android:id="@+id/close4" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:src="@drawable/ic_close_w" android:background="#80000000" android:padding="4dp" android:scaleType="fitCenter" />
                <TextView android:id="@+id/title4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="#80000000" android:padding="4dp" android:textColor="#FFFFFF" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#CC000000"
        android:padding="8dp"
        android:gravity="center_vertical">

        <Button android:id="@+id/btnPickSlot1" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Slot 1" android:textSize="10sp" />
        <Button android:id="@+id/btnPickSlot2" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Slot 2" android:textSize="10sp" />
        <Button android:id="@+id/btnPickSlot3" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Slot 3" android:textSize="10sp" />
        <Button android:id="@+id/btnPickSlot4" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="Slot 4" android:textSize="10sp" />

        <ImageButton android:id="@+id/btnLayoutToggle" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:src="@drawable/ic_grid_w" android:background="@drawable/bg_glass_button" android:padding="8dp" android:scaleType="fitCenter" android:contentDescription="Ganti layout" />

        <ImageButton android:id="@+id/btnCloseMulti" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="4dp" android:src="@drawable/ic_close_w" android:background="@drawable/bg_glass_button" android:padding="8dp" android:scaleType="fitCenter" android:contentDescription="Tutup" />
    </LinearLayout>
</FrameLayout>
