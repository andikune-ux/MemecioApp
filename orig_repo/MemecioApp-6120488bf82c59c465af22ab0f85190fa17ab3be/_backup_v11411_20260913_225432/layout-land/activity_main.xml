<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_app_background"
    android:fitsSystemWindows="false">

    <!-- Kolom Nav Kiri (Beranda/Sumber/Profil) — Java pakai findViewById langsung -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_nav_bar_dark"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <FrameLayout
            android:id="@+id/btnBeranda"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_nav_tab_white"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false">
            <FrameLayout
                android:id="@+id/bulletBeranda"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_bullet_blue">
                <ImageView
                    android:id="@+id/tvIconBeranda"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSumber"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_nav_tab_white"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false">
            <FrameLayout
                android:id="@+id/bulletSumber"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_bullet_blue">
                <ImageView
                    android:id="@+id/tvIconSumber"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_source"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnProfil"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_tab_white"
            android:clickable="true"
            android:focusable="true"
            android:clipChildren="false"
            android:clipToPadding="false">
            <FrameLayout
                android:id="@+id/bulletProfil"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_nav_bullet_blue">
                <ImageView
                    android:id="@+id/tvIconProfil"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_profile"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Container -->
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- Placeholder untuk Java -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <TextView android:id="@+id/tvLabelBeranda" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvLabelSumber" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvLabelProfil" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvSortLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvHariTanggal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvKoneksiIndicator" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/tvJamRealtime" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
