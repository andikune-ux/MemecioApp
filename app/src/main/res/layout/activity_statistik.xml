<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackStatistik"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&lt;"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Statistik Penggunaan"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_dark" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTotalMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Media: 0"
                android:textSize="15sp"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_dark"
                android:padding="16dp"
                android:background="@drawable/bg_glass_card"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/barContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_card" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
