<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBackStreaming"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="&#8592;"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:background="@drawable/bg_glass_button" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="130dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_glass_card"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar Playlist"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_grey"
                android:paddingBottom="6dp"/>

            <ListView
                android:id="@+id/listSavedLinks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etStreamingUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Masukkan link M3U8/MP4"
                android:padding="14dp"
                android:background="@drawable/bg_glass_card" />

            <Button
                android:id="@+id/btnUploadM3u"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Pilih File M3U"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_glass_button_selected"
                android:textColor="#FFFFFF"/>

            <Button
                android:id="@+id/btnTampilkanStreaming"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Tampilkan"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_glass_button_selected"
                android:textColor="#FFFFFF"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

