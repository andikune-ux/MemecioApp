<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="14dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/btnBackCrashHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textSize="24sp"
            android:textColor="#1C1C1E"
            android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Riwayat Crash Log"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/btnHapusCrashHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hapus"
            android:textSize="13sp"
            android:textColor="#E53935"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCrashHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tidak ada riwayat crash"
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="40dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listCrashHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:padding="8dp" />
</LinearLayout>
