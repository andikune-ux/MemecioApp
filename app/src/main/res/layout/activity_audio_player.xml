<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnBackAudio"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8592;"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Audio Player"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_play"
        android:background="#FFFFFF"
        android:padding="32dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvAudioTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Audio"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginBottom="24dp" />

    <SeekBar
        android:id="@+id/seekAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#3D5AFE"
        android:thumbTint="#FFFFFF"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAudioCurrent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAudioDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnAudioSleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="&#128564;"
            android:textSize="16sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <ImageView
            android:id="@+id/btnAudioPrev"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_prev_w"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnAudioPlayPause"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_play_w"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_glass_button_selected"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnAudioNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_next_w"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <ImageView
            android:id="@+id/btnAudioRewind"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_rewind_w"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/btnAudioForward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:src="@drawable/ic_forward_w"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
