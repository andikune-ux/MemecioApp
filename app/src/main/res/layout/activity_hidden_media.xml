<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackHidden"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8592;"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvHiddenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Media Tersembunyi"
            android:textSize="17sp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <FrameLayout
            android:id="@+id/btnToggleSelect"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="6dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_select_all"
                android:layout_gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnPulihkanTerpilih"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_button_selected"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_restore"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHiddenInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="0 item"
        android:textSize="11sp"
        android:textColor="@color/text_grey" />

    <TextView
        android:id="@+id/tvHiddenEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Tidak ada media tersembunyi"
        android:textSize="14sp"
        android:textColor="@color/text_grey"
        android:visibility="gone" />

    <GridView
        android:id="@+id/gridHidden"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="3"
        android:horizontalSpacing="4dp"
        android:verticalSpacing="4dp"
        android:padding="6dp"
        android:stretchMode="columnWidth" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        android:background="@drawable/bg_glass_topbar">

        <TextView
            android:id="@+id/btnHapusTerpilih"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Hapus Permanen"
            android:textSize="13sp"
            android:textColor="#E53935"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnPulihkanBottom"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Pulihkan"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/bg_glass_button_selected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
