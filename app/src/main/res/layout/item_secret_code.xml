<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvCodePill"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_nav_tab_white"
        android:gravity="center"
        android:text="000"
        android:textColor="@color/nav_selected"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Fitur"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/tvCodeDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Deskripsi fitur rahasia ini"
            android:textSize="11sp"
            android:textColor="@color/text_grey" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRunCode"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Jalankan"
        android:textSize="11sp"
        android:background="@drawable/bg_button_primary"
        android:textColor="#FFFFFF" />

</LinearLayout>
