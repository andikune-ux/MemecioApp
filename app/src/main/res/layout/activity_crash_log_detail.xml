<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackCrashDetail"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="&#8592;"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvCrashDetailTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/btnCopyCrash"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Salin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_glass_button_selected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvCrashDetailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_dark" />
    </ScrollView>
</LinearLayout>

