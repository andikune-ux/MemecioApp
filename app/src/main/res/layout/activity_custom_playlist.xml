<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackCustomPlaylist"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&lt;"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Playlist Manual"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/btnTambahPlaylist"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="+ Baru"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/bg_glass_button_selected" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCustomPlaylistEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Belum ada playlist manual"
        android:textSize="14sp"
        android:textColor="@color/text_grey" />

    <ListView
        android:id="@+id/listCustomPlaylist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:listSelector="@drawable/bg_grid_selector"
        android:drawSelectorOnTop="true" />
</LinearLayout>
