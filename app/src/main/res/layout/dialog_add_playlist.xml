<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tambah ke Playlist"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1C1C1E"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/tvEmptyPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada playlist"
        android:textSize="13sp"
        android:textColor="#888888"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listPlaylistChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="280dp" />

    <Button
        android:id="@+id/btnBuatPlaylistBaru"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="+ Buat Playlist Baru"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_button_primary" />

    <Button
        android:id="@+id/btnBatalPlaylist"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:text="Batal"
        android:textSize="13sp"
        android:textColor="#555555"
        android:background="@android:color/transparent" />
</LinearLayout>
