<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_cream">
    <LinearLayout android:id="@+id/rightContentContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:visibility="visible">
                <ImageView android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_source" app:tint="@color/text_grey" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Belum ada media" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Pilih sumber di menu Sumber untuk mulai" android:textSize="11sp" android:textColor="@color/text_grey" />
            </LinearLayout>
            <GridView android:id="@+id/gridBeranda" android:layout_width="match_parent" android:layout_height="match_parent" android:numColumns="5" android:verticalSpacing="6dp" android:horizontalSpacing="6dp" android:visibility="gone" android:focusable="true" android:focusableInTouchMode="true" android:listSelector="@drawable/bg_grid_selector" android:drawSelectorOnTop="true" android:paddingBottom="88dp" android:clipToPadding="false" />
            <ScrollView android:id="@+id/scrollKategori" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:fillViewport="true">
                <LinearLayout android:id="@+id/kategoriList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp" />
            </ScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp">
                    <ImageButton android:id="@+id/btnToggleSidebar" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_source" android:background="@drawable/bg_filter_transparent" android:contentDescription="Playlist" android:scaleType="fitCenter" android:padding="8dp" />
                    <TextView android:id="@+id/btnFilterSemua" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" android:text="Semua" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="7dp" android:textColor="#FFFFFF" android:background="@drawable/bg_glass_button_selected" />
                    <TextView android:id="@+id/btnFilterFoto" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Foto" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="7dp" android:textColor="@color/text_dark" android:background="@drawable/bg_filter_transparent" />
                    <TextView android:id="@+id/btnFilterVideo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Video" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="7dp" android:textColor="@color/text_dark" android:background="@drawable/bg_filter_transparent" />
                    <ImageButton android:id="@+id/btnMultiview" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp" android:src="@drawable/ic_grid_w" android:background="@drawable/bg_filter_transparent" android:contentDescription="Multiview" android:scaleType="fitCenter" android:padding="8dp" android:clickable="true" android:focusable="true" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="4dp">
                    <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:hint="Cari" android:textSize="13sp" android:background="@drawable/bg_search_transparent" android:paddingStart="12dp" android:paddingEnd="12dp" android:inputType="text" android:singleLine="true" />
                    <ImageButton android:id="@+id/btnSearch" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:src="@android:drawable/ic_menu_search" android:background="@drawable/bg_search_transparent" android:contentDescription="Cari" android:scaleType="fitCenter" android:padding="8dp" app:tint="#000000" />
                </LinearLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="4dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/historyChipsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <HorizontalScrollView android:id="@+id/categoryChipScroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="6dp" android:scrollbars="none" android:visibility="gone">
                    <LinearLayout android:id="@+id/categoryChipsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/sidebarContainer" android:layout_width="280dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="vertical" android:paddingTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:background="@drawable/bg_glass_card" android:visibility="gone">
        <TextView android:id="@+id/tvSidebarTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Daftar Playlist" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:padding="8dp" android:singleLine="true" android:ellipsize="end" />
        <ListView android:id="@+id/sidebarSavedLinks" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@null" android:dividerHeight="8dp" android:scrollbars="vertical" android:focusable="true" android:focusableInTouchMode="true" android:listSelector="@drawable/bg_grid_selector" android:drawSelectorOnTop="true" />
    </LinearLayout>
    <FrameLayout android:id="@+id/overlayExpand" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5FBF9F4" android:visibility="gone" android:clickable="true" android:focusable="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                <TextView android:id="@+id/tvExpandTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kategori" android:textColor="#1C1C1E" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
                <ImageButton android:id="@+id/btnShrink" android:layout_width="42dp" android:layout_height="42dp" android:src="@android:drawable/ic_menu_revert" android:background="@drawable/bg_glass_button" android:padding="10dp" android:scaleType="fitCenter" android:focusable="true" android:focusableInTouchMode="true" />
            </LinearLayout>
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
                <GridLayout android:id="@+id/gridExpand" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="4" android:padding="8dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>