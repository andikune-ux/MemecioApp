<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:padding="16dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="48sp"
        android:maxLines="2"
        android:ellipsize="start" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <TextView android:id="@+id/btnClear" android:text="C" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnDel" android:text="⌫" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnPercent" android:text="%" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnDivide" android:text="÷" android:textColor="#FF9500" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>

        <TextView android:id="@+id/btn7" android:text="7" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn8" android:text="8" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn9" android:text="9" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnMultiply" android:text="×" android:textColor="#FF9500" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>

        <TextView android:id="@+id/btn4" android:text="4" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn5" android:text="5" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn6" android:text="6" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnMinus" android:text="−" android:textColor="#FF9500" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>

        <TextView android:id="@+id/btn1" android:text="1" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn2" android:text="2" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn3" android:text="3" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnPlus" android:text="+" android:textColor="#FF9500" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#333333" android:layout_margin="2dp"/>

        <TextView android:id="@+id/btnDot" android:text="." android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn0" android:text="0" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btn00" android:text="00" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#222222" android:layout_margin="2dp"/>
        <TextView android:id="@+id/btnEquals" android:text="=" android:textColor="#FFFFFF" android:textSize="24sp" android:gravity="center" android:layout_columnWeight="1" android:layout_width="0dp" android:layout_height="70dp" android:clickable="true" android:focusable="true" android:background="#FF9500" android:layout_margin="2dp"/>

    </GridLayout>
</LinearLayout>

