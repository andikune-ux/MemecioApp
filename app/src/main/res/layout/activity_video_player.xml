<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit" />

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnCloseVideo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_close_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Tutup"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnPlaylist"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_playlist_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Daftar Playlist"
                android:padding="10dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnLock"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_lock_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Kunci Layar"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_settings_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Pengaturan"
                android:padding="10dp"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="100dp"
            android:src="@android:drawable/ic_menu_crop"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Fullscreen"
            android:padding="10dp"
            android:scaleType="fitCenter" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvJamVideoPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="14dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="8" />

    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_prev_w"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Sebelumnya"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnRewind"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_rewind_w"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Mundur"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnPlayPauseCenter"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_pause_w"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Play/Pause"
            android:padding="18dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_forward_w"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Maju"
            android:padding="12dp"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:src="@drawable/ic_next_w"
            android:background="@drawable/bg_icon_transparent"
            android:contentDescription="Berikutnya"
            android:padding="12dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tvLockedIndicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_lock_w"
        android:background="@drawable/bg_icon_transparent"
        android:padding="16dp"
        android:scaleType="fitCenter"
        android:contentDescription="Layar Terkunci"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_ios_glass_bar"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:progressDrawable="@drawable/bg_seekbar_custom"
            android:thumb="@drawable/bg_seekbar_thumb_normal"
            android:splitTrack="false"
            android:maxHeight="12dp"
            android:minHeight="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_pause_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Play/Pause"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_unmute_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Suara"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvTimecode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="00:00 / 00:00"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:textColor="#1C1C1E"
                android:fontFamily="sans-serif-medium"
                android:textSize="12sp"
                android:background="@drawable/bg_icon_transparent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawerPlaylist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@drawable/bg_ios_glass_drawer"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnPlaylistPrev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_prev_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Playlist Sebelumnya"
                android:padding="10dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvPlaylistName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text="Playlist"
                android:textColor="#1C1C1E"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true" />

            <ImageButton
                android:id="@+id/btnPlaylistNext"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_next_w"
                android:background="@drawable/bg_icon_transparent"
                android:contentDescription="Playlist Berikutnya"
                android:padding="10dp"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <ListView
            android:id="@+id/listVideoTitles"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:divider="@null"
            android:dividerHeight="6dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/previewContainer"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:background="@drawable/bg_preview_container"
        android:padding="4dp"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="112dp"
            android:layout_height="63dp"
            android:scaleType="fitCenter"
            android:background="#000000" />

        <TextView
            android:id="@+id/previewTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingTop="2dp" />
    </LinearLayout>


    <include
        layout="@layout/gesture_indicator"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />


    <include
        layout="@layout/video_detail_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
