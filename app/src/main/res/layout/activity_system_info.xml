<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FA">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#FFFFFF" android:padding="14dp" android:elevation="2dp">
        <TextView android:id="@+id/btnBackSystem" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="←" android:textSize="24sp"
            android:textColor="#1C1C1E" android:padding="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="System Info" android:textSize="17sp"
            android:textStyle="bold" android:textColor="#1C1C1E" android:layout_marginStart="12dp" />
        <TextView android:id="@+id/btnSalinSystem" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Salin" android:textSize="13sp"
            android:textColor="#3D5AFE" android:padding="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="12dp">
        <TextView android:id="@+id/tvSystemContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:fontFamily="monospace"
            android:textSize="12sp" android:textColor="#1C1C1E" android:padding="8dp"
            android:background="@drawable/bg_glass_card" />
    </ScrollView>
</LinearLayout>
