<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_grid_selector"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/frameKat"
        android:layout_width="110dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_glass_card">

        <ImageView
            android:id="@+id/imgThumbKat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#12000000" />

        <View
            android:id="@+id/overlayKat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvPlayBadgeKat"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:text="PLAY"
            android:textColor="#FFFFFF"
            android:textSize="7sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/bg_glass_button_selected"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitleKat"
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:padding="3dp"
        android:text=""
        android:textColor="#1C1C1E"
        android:textSize="7sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
