<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-Skip Intro (detik)"
        android:textColor="#1C1C1E"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/etSkipIntro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0 = mati"
        android:inputType="number"
        android:padding="12dp"
        android:background="@drawable/bg_glass_button"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Auto-Skip Outro (detik)"
        android:textColor="#1C1C1E"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <EditText
        android:id="@+id/etSkipOutro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="0 = mati"
        android:inputType="number"
        android:padding="12dp"
        android:background="@drawable/bg_glass_button"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSkipBatal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="#1C1C1E"
            android:background="@drawable/bg_glass_button" />

        <Button
            android:id="@+id/btnSkipSimpan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_glass_button_selected" />
    </LinearLayout>
</LinearLayout>
