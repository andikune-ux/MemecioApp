<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Auto Exit Timer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aplikasi keluar otomatis setelah waktu habis"
        android:textSize="11sp"
        android:textColor="@color/text_grey"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/btnExit5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5 menit"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExit15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="15 menit"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExit30"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="30 menit"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExit60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="60 menit"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExit120"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="120 menit"
        android:textSize="15sp"
        android:textColor="@color/text_dark"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExitCancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Matikan Auto Exit"
        android:textSize="14sp"
        android:textColor="#E53935"
        android:padding="14dp"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/btnExitBatal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Batal"
        android:textSize="13sp"
        android:textColor="#888888"
        android:padding="12dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
