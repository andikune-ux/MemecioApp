<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_thumbnail_rounded" android:padding="3dp" android:clipToOutline="true">
    <ImageView android:id="@+id/imgThumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="#12000000" />
    <TextView android:id="@+id/tvPlayBadge" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:text="Play" android:textColor="#FFFFFF" android:textSize="7sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/bg_glass_button_selected" android:visibility="gone" />
    <TextView android:id="@+id/btnHide" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="top|start" android:layout_margin="4dp" android:text="Hide" android:textColor="#FFFFFF" android:textSize="7sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:background="@drawable/bg_glass_button_selected" android:clickable="true" android:focusable="true" android:visibility="gone" />
    <TextView android:id="@+id/tvM3uBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="4dp" android:text="M3U" android:textSize="8sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/bg_glass_button_selected" android:visibility="gone" />
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:text="" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" android:padding="5dp" android:background="@drawable/bg_glass_selected_gradient_bottom" android:visibility="gone" />
</FrameLayout>