<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBackServer"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="&#8592;"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:background="@drawable/bg_glass_button" />

    <TextView
        android:id="@+id/tvSelectedFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_dark"/>

    <ProgressBar
        android:id="@+id/progressUpload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:progressTint="@color/primary"/>

    <TextView
        android:id="@+id/tvUploadPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_grey"/>

    <Button
        android:id="@+id/btnUploadServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Pilih File"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_glass_button_selected"
        android:textColor="#FFFFFF"/>

    <Button
        android:id="@+id/btnTampilkanServer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Tampilkan"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_glass_button_selected"
        android:textColor="#FFFFFF"/>
</LinearLayout>

