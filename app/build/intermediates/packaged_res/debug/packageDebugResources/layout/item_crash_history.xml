<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/tvCrashHistoryDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#E53935" />

        <TextView
            android:id="@+id/tvCrashHistoryTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="12 Sep 2026, 16:45:00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1C1C1E"
            android:layout_marginStart="10dp" />

        <TextView
            android:id="@+id/tvCrashHistoryType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FORCE CLOSE"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#E53935"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCrashHistorySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NullPointerException at MainActivity.setupSidebar"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginTop="6dp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
