<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackRiwayat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8592;"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Riwayat"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/btnExportRiwayat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Export"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnHapusSemuaRiwayat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:text="&#128465;"
            android:textSize="16sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etSearchRiwayat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cari URL..."
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:padding="10dp"
            android:background="@drawable/bg_glass_card"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvRiwayatEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Belum ada riwayat link"
        android:textSize="14sp"
        android:textColor="@color/text_grey"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listRiwayat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:listSelector="@drawable/bg_grid_selector"
        android:drawSelectorOnTop="true" />
</LinearLayout>
