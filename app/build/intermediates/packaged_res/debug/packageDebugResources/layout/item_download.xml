<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvDownloadIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="&#8681;"
        android:textSize="20sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:background="@drawable/bg_glass_button" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvDownloadName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="video.mp4"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:maxLines="2"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/tvDownloadInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.2 MB • 12 Sep 2026"
            android:textSize="11sp"
            android:textColor="@color/text_grey"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnHapusDownload"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="&#10005;"
        android:textSize="14sp"
        android:textColor="#E53935"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
