<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_card"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Judul Playlist"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_dark" />

    <EditText
        android:id="@+id/etJudulPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nama playlist"
        android:background="@drawable/bg_glass_button"
        android:padding="12dp" />

    <TextView
        android:id="@+id/btnTampilkanPopup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tampilkan"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:padding="12dp"
        android:background="@drawable/bg_glass_button_selected"
        android:clickable="true"
        android:focusable="true" />
        <TextView
            android:id="@+id/btnBatalPopup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Batal"
            android:textColor="#888888"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="12dp"
            android:clickable="true"
            android:focusable="true" />
</LinearLayout>

