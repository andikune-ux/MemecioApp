<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBackDrive"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:text="&lt;"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:gravity="center"
        android:background="@drawable/bg_glass_button"
        android:clickable="true"
        android:focusable="true" />

    <EditText
        android:id="@+id/etDriveUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Paste link Google Drive (File / Folder)"
        android:padding="14dp"
        android:background="@drawable/bg_glass_card"
        android:inputType="textUri"
        android:singleLine="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Link pintar: otomatis deteksi folder, foto, atau video"
        android:textSize="12sp"
        android:textColor="@color/text_grey" />

    <Button
        android:id="@+id/btnTampilkanDrive"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="Tampilkan"
        android:textAllCaps="false"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/bg_glass_button_selected"
        android:textColor="#FFFFFF" />
</LinearLayout>
