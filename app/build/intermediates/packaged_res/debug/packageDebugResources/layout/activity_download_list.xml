<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btnBackDownload"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8592;"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daftar Download"
            android:textSize="18sp"
            android:textColor="@color/text_dark"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <TextView
            android:id="@+id/btnRefreshDownload"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Refresh"
            android:textSize="13sp"
            android:textColor="@color/primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDownloadPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="/sdcard/Termux/Download/"
        android:textSize="11sp"
        android:textColor="@color/text_grey"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/tvDownloadEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Belum ada file download"
        android:textSize="14sp"
        android:textColor="@color/text_grey"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listDownload"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:divider="@null"
        android:dividerHeight="8dp" />
</LinearLayout>
