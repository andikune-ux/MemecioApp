<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground">

    <ImageView
        android:layout_width="20dp" android:layout_height="20dp"
        android:src="@drawable/ic_playlist_w" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistChoiceName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#1C1C1E"
            android:text="Nama Playlist" />

        <TextView
            android:id="@+id/tvPlaylistChoiceCount"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#888888"
            android:text="0 item" />
    </LinearLayout>
</LinearLayout>
