<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item android:top="4dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <gradient
                        android:angle="90"
                        android:startColor="#CC555555"
                        android:centerColor="#80333333"
                        android:endColor="#CC555555"
                        android:type="linear" />
                    <stroke android:width="0.5dp" android:color="#40FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item android:top="4dp" android:bottom="4dp">
                    <shape android:shape="rectangle">
                        <corners android:radius="2dp" />
                        <gradient
                            android:angle="0"
                            android:startColor="#3D5AFE"
                            android:centerColor="#FFFFFF"
                            android:endColor="#3D5AFE"
                            android:type="linear" />
                    </shape>
                </item>
                <item android:top="5.5dp" android:bottom="5.5dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#FF80ABFF" />
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
</layer-list>
