<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fill abu-abu sangat muda -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F5" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Glow luar -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="20dp" />
            <stroke android:width="8dp" android:color="#44888888" />
        </shape>
    </item>
    <!-- Ring utama abu tua -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="17dp" />
            <stroke android:width="4dp" android:color="#FF404040" />
        </shape>
    </item>
</layer-list>
