<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_cream"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/btnBrowserBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#8592;"
            android:textColor="@color/text_dark"
            android:textSize="18sp"
            android:gravity="center"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Plugin Browser"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plugin:"
            android:textSize="12sp"
            android:textColor="@color/text_dark" />
        <Spinner
            android:id="@+id/spinnerPlugin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />

        <Switch
            android:id="@+id/switchCariSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Cari di semua plugin"
            android:textSize="12sp"
            android:textColor="@color/text_dark" />

        <EditText
            android:id="@+id/etPluginSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:hint="Cari film..."
            android:textSize="13sp"
            android:inputType="text"
            android:maxLines="1" />
        <TextView
            android:id="@+id/btnPluginDebug"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:text="Debug"
            android:textColor="@color/text_dark"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_glass_button"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnPluginSearch"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="Cari"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/bg_glass_button_selected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBrowserStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text=""
        android:textColor="@color/text_grey"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <GridView
            android:id="@+id/gridPluginHasil"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="5"
            android:verticalSpacing="6dp"
            android:horizontalSpacing="6dp" />
        <TextView
            android:id="@+id/tvBrowserKosong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Belum ada plugin aktif. Install plugin dulu di Kelola Plugin."
            android:textColor="@color/text_grey"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
