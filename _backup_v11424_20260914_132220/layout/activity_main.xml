<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_app_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="@drawable/bg_glass_card">

            <ImageView
                android:id="@+id/imgLogoHeader"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_logo_memecio"
                android:scaleType="centerCrop"
                android:contentDescription="Logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Memec.io"
                android:textColor="@color/text_dark"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/tvHariTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_grey"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvKoneksiIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="12sp"
                android:textColor="#000000"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/tvJamRealtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_dark" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="6dp" android:paddingEnd="6dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/btnBeranda"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_nav_tab_white"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <FrameLayout
                    android:id="@+id/bulletBeranda"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:elevation="6dp"
                    android:background="@drawable/bg_nav_bullet_blue">
                    <ImageView
                        android:id="@+id/tvIconBeranda"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        app:tint="#727272" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tvLabelBeranda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:text="Beranda"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#666666"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnSumber"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_nav_tab_white"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <FrameLayout
                    android:id="@+id/bulletSumber"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:elevation="6dp"
                    android:background="@drawable/bg_nav_bullet_blue">
                    <ImageView
                        android:id="@+id/tvIconSumber"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_source"
                        app:tint="#727272" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tvLabelSumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:text="Sumber"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#666666"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnProfil"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_nav_tab_white"
                android:clickable="true"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false">
                <FrameLayout
                    android:id="@+id/bulletProfil"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:elevation="6dp"
                    android:background="@drawable/bg_nav_bullet_blue">
                    <ImageView
                        android:id="@+id/tvIconProfil"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:tint="#727272" />
                </FrameLayout>
                <TextView
                    android:id="@+id/tvLabelProfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="4dp"
                    android:text="Profil"
                    android:textSize="9sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#666666"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
