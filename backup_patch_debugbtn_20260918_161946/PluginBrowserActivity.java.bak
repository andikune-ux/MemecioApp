package com.memecio.app;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Intent;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.net.Uri;
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;
import android.text.TextUtils;
import android.view.View;
import android.widget.AdapterView;
import android.widget.ArrayAdapter;
import android.widget.EditText;
import android.widget.GridView;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.Spinner;
import android.widget.Switch;
import android.widget.TextView;
import android.widget.Toast;

import com.memecio.app.plugin.MemecioPlugin;
import com.memecio.app.plugin.MemecioProvider;
import com.memecio.app.plugin.PluginManager;
import com.memecio.app.plugin.model.PluginLink;
import com.memecio.app.plugin.model.PluginMediaItem;
import com.memecio.app.plugin.model.PluginSearchResult;

import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.util.ArrayList;
import java.util.List;

public class PluginBrowserActivity extends Activity {

    private Spinner spinnerPlugin;
    private Switch switchCariSemua;
    private EditText etSearch;
    private GridView gridHasil;
    private TextView tvStatus, tvKosong;
    private PluginItemAdapter adapter;

    private final List<MemecioPlugin> plugins = new ArrayList<>();
    private final Handler ui = new Handler(Looper.getMainLooper());

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_plugin_browser);

        View btnBack = findViewById(R.id.btnBrowserBack);
        if (btnBack != null) btnBack.setOnClickListener(v -> finish());

        spinnerPlugin = findViewById(R.id.spinnerPlugin);
        switchCariSemua = findViewById(R.id.switchCariSemua);
        etSearch = findViewById(R.id.etPluginSearch);
        gridHasil = findViewById(R.id.gridPluginHasil);
        tvStatus = findViewById(R.id.tvBrowserStatus);
        tvKosong = findViewById(R.id.tvBrowserKosong);

        adapter = new PluginItemAdapter(this);
        gridHasil.setAdapter(adapter);
        gridHasil.setOnItemClickListener((parent, view, position, id) -> {
            Object obj = adapter.getItem(position);
            bukaDetail(obj);
        });

        View btnSearch = findViewById(R.id.btnPluginSearch);
        if (btnSearch != null) btnSearch.setOnClickListener(v -> lakukanSearch());

        refreshPlugins();

        if (plugins.isEmpty()) {
            tampilKosong("Belum ada plugin aktif. Install plugin dulu di Kelola Plugin.");
        } else {
            muatMainPage();
        }
    }

    private void refreshPlugins() {
        plugins.clear();
        plugins.addAll(PluginManager.getActive());

        List<String> names = new ArrayList<>();
        for (MemecioPlugin p : plugins) names.add(p.getName());

        ArrayAdapter<String> spAdapter = new ArrayAdapter<>(this,
                android.R.layout.simple_spinner_item, names);
        spAdapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item);
        spinnerPlugin.setAdapter(spAdapter);

        spinnerPlugin.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
            @Override public void onItemSelected(AdapterView<?> a, View v, int pos, long id) {
                muatMainPage();
            }
            @Override public void onNothingSelected(AdapterView<?> a) {}
        });
    }

    private MemecioProvider getCurrentProvider() {
        if (plugins.isEmpty()) return null;
        int pos = spinnerPlugin.getSelectedItemPosition();
        if (pos < 0 || pos >= plugins.size()) pos = 0;
        return plugins.get(pos).getProvider();
    }

    private void muatMainPage() {
        MemecioProvider p = getCurrentProvider();
        if (p == null) {
            tampilKosong("Belum ada plugin aktif.");
            return;
        }
        tvStatus.setText("Memuat...");
        new Thread(() -> {
            List<PluginMediaItem> items = null;
            try { items = p.getMainPage(); } catch (Throwable t) { items = null; }
            final List<PluginMediaItem> itemsFinal = items;
            ui.post(() -> {
                if (itemsFinal == null || itemsFinal.isEmpty()) {
                    tampilKosong("Tidak ada konten dari plugin ini.");
                    return;
                }
                adapter.setMediaItems(itemsFinal);
                tvKosong.setVisibility(View.GONE);
                gridHasil.setVisibility(View.VISIBLE);
                tvStatus.setText(itemsFinal.size() + " item");
            });
        }).start();
    }

    private void lakukanSearch() {
        final String q = etSearch.getText().toString().trim();
        if (TextUtils.isEmpty(q)) {
            muatMainPage();
            return;
        }
        tvStatus.setText("Mencari: " + q + "...");

        new Thread(() -> {
            List<PluginSearchResult> hasil = new ArrayList<>();
            if (switchCariSemua != null && switchCariSemua.isChecked()) {
                // Cari di semua plugin
                for (MemecioPlugin pl : plugins) {
                    try {
                        List<PluginSearchResult> r = pl.getProvider().search(q);
                        if (r != null) hasil.addAll(r);
                    } catch (Throwable ignored) {}
                }
            } else {
                // Cari di plugin terpilih
                MemecioProvider p = getCurrentProvider();
                if (p != null) {
                    try {
                        List<PluginSearchResult> r = p.search(q);
                        if (r != null) hasil.addAll(r);
                    } catch (Throwable ignored) {}
                }
            }
            final List<PluginSearchResult> finalHasil = hasil;
            ui.post(() -> {
                if (finalHasil.isEmpty()) {
                    String msg = "Tidak ada hasil untuk \"" + q + "\"";
                    // Ambil error dari adapter CloudStream (kalau ada)
                    String adapterErr = com.memecio.app.plugin.CloudStreamProviderAdapter.getLastError();
                    if (adapterErr != null && !adapterErr.isEmpty()) {
                        msg = msg + "\n\nError plugin:\n" + adapterErr;
                    }
                    tvKosong.setText(msg);
                    tvKosong.setTextIsSelectable(true);
                    tvKosong.setVisibility(View.VISIBLE);
                    gridHasil.setVisibility(View.GONE);
                    tvStatus.setText("0 hasil");
                    return;
                }
                adapter.setSearchResults(finalHasil);
                tvKosong.setVisibility(View.GONE);
                gridHasil.setVisibility(View.VISIBLE);
                tvStatus.setText(finalHasil.size() + " hasil");
            });
        }).start();
    }

    private void tampilKosong(String msg) {
        tvKosong.setText(msg);
        tvKosong.setVisibility(View.VISIBLE);
        gridHasil.setVisibility(View.GONE);
        tvStatus.setText("");
    }

    private void bukaDetail(Object obj) {
        final String title;
        final String poster;
        final int year;
        final PluginMediaItem itemForDetail;
        final PluginSearchResult searchRef;

        if (obj instanceof PluginSearchResult) {
            PluginSearchResult r = (PluginSearchResult) obj;
            searchRef = r;
            title = r.title;
            poster = r.posterUrl;
            year = r.year;
            PluginMediaItem tmp = new PluginMediaItem(r.id, r.title, r.url);
            tmp.posterUrl = r.posterUrl;
            tmp.year = r.year;
            itemForDetail = tmp;
        } else if (obj instanceof PluginMediaItem) {
            searchRef = null;
            PluginMediaItem m = (PluginMediaItem) obj;
            title = m.title;
            poster = m.posterUrl;
            year = m.year;
            itemForDetail = m;
        } else {
            return;
        }

        // Load detail dulu (async)
        tvStatus.setText("Memuat detail...");
        new Thread(() -> {
            PluginMediaItem detailItem = itemForDetail;
            try {
                MemecioProvider p = getCurrentProvider();
                if (p != null) {
                    detailItem = p.loadDetail(itemForDetail);
                }
            } catch (Throwable t) {
                // ignore, pakai item asli
            }
            final PluginMediaItem finalDetail = detailItem;
            ui.post(() -> {
                tvStatus.setText("");
                tampilkanDialogDetail(finalDetail, searchRef);
            });
        }).start();
    }

    private void tampilkanDialogDetail(PluginMediaItem itemForDetail,
                                        PluginSearchResult searchRef) {
        final String title = itemForDetail.title;
        final String poster = itemForDetail.posterUrl;
        final String desc = itemForDetail.description;
        final int year = itemForDetail.year;
        final String duration = itemForDetail.duration;
        final int episodeCount = itemForDetail.episodeCount;

        // Dialog detail
        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setPadding(40, 30, 40, 20);

        ImageView img = new ImageView(this);
        img.setLayoutParams(new LinearLayout.LayoutParams(
                LinearLayout.LayoutParams.MATCH_PARENT, 400));
        img.setScaleType(ImageView.ScaleType.CENTER_CROP);
        img.setImageResource(R.drawable.ic_plugin);
        if (poster != null && !poster.isEmpty()) {
            final String urlFinal = poster;
            new Thread(() -> {
                Bitmap bmp = loadBitmap(urlFinal);
                if (bmp != null) ui.post(() -> img.setImageBitmap(bmp));
            }).start();
        }
        layout.addView(img);

        TextView tvTitle = new TextView(this);
        tvTitle.setText(title != null ? title : "");
        tvTitle.setTextSize(16f);
        tvTitle.setTypeface(null, android.graphics.Typeface.BOLD);
        tvTitle.setPadding(0, 20, 0, 8);
        layout.addView(tvTitle);

        TextView tvInfo = new TextView(this);
        StringBuilder info = new StringBuilder();
        if (year > 0) info.append("Tahun: ").append(year);
        if (duration != null && !duration.isEmpty()) {
            if (info.length() > 0) info.append("  |  ");
            info.append("Durasi: ").append(duration);
        }
        if (episodeCount > 0) {
            if (info.length() > 0) info.append("  |  ");
            info.append("Episode: ").append(episodeCount);
        }
        if (info.length() > 0) info.append("\n\n");
        if (desc != null && !desc.isEmpty()) info.append(desc);
        tvInfo.setText(info.toString());
        tvInfo.setTextSize(12f);
        tvInfo.setMaxLines(15);
        layout.addView(tvInfo);

        final PluginMediaItem fMedia = itemForDetail;
        final PluginSearchResult fResult = searchRef;

        new AlertDialog.Builder(this)
            .setView(layout)
            .setNegativeButton("Batal", null)
            .setPositiveButton("Play", (d, w) -> playItem(fMedia, fResult))
            .show();
    }

    private void playItem(PluginMediaItem mediaItem, PluginSearchResult searchResult) {
        tvStatus.setText("Mengambil link...");
        new Thread(() -> {
            try {
                PluginMediaItem target = mediaItem;
                if (target == null && searchResult != null) {
                    target = new PluginMediaItem(searchResult.id, searchResult.title, searchResult.url);
                    target.posterUrl = searchResult.posterUrl;
                    target.year = searchResult.year;
                    target.type = searchResult.type;
                }
                if (target == null) {
                    ui.post(() -> tvStatus.setText("Item tidak valid"));
                    return;
                }
                MemecioProvider p = getCurrentProvider();
                if (p == null) {
                    ui.post(() -> tvStatus.setText("Plugin tidak aktif"));
                    return;
                }
                final List<PluginLink> links = p.loadLinks(target);
                final List<PluginLink> linksFinal = links;
                final PluginMediaItem targetFinal = target;
                ui.post(() -> {
                    if (linksFinal == null || linksFinal.isEmpty()) {
                        String err = com.memecio.app.plugin.CloudStreamProviderAdapter.getLastError();
                        String msg = "Link video tidak tersedia";
                        if (err != null && !err.isEmpty()) msg = msg + "\n\nError plugin:\n" + err;
                        tvStatus.setText(msg);
                        tvStatus.setTextIsSelectable(true);
                        Toast.makeText(this, "Link tidak tersedia", Toast.LENGTH_SHORT).show();
                        return;
                    }
                    tvStatus.setText("Memutar " + linksFinal.size() + " link...");
                    jalankanVideo(linksFinal, targetFinal);
                });
            } catch (Throwable t) {
                ui.post(() -> tvStatus.setText("Error: " + t.getMessage()));
            }
        }).start();
    }

    private void jalankanVideo(List<PluginLink> links, PluginMediaItem item) {
        // Ambil link pertama
        PluginLink l = links.get(0);

        // Buat MediaItem untuk playlist
        MediaItem m = new MediaItem(Uri.parse(l.url), MediaItem.TYPE_VIDEO);
        m.title = item.title;
        m.thumbUrl = item.posterUrl;
        m.sourceTitle = "Plugin";
        m.isLocal = false;

        List<MediaItem> mixed = new ArrayList<>();
        mixed.add(m);

        ArrayList<String> videoPlaylist = new ArrayList<>();
        videoPlaylist.add(l.url);

        PlaylistHolder.set(videoPlaylist);
        MixedPlaylistHolder.set(mixed, 0);

        Intent intent = new Intent(this, VideoPlayerActivity.class);
        intent.putExtra("index", 0);
        startActivity(intent);
    }

    private Bitmap loadBitmap(String url) {
        HttpURLConnection conn = null;
        try {
            URL u = new URL(url);
            conn = (HttpURLConnection) u.openConnection();
            conn.setConnectTimeout(8000);
            conn.setReadTimeout(8000);
            conn.setRequestProperty("User-Agent", "MemecioApp/1.0");
            InputStream in = conn.getInputStream();
            Bitmap bmp = BitmapFactory.decodeStream(in);
            in.close();
            return bmp;
        } catch (Exception e) {
            return null;
        } finally {
            if (conn != null) try { conn.disconnect(); } catch (Exception ignored) {}
        }
    }
}
