<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="16dp" android:background="@drawable/bg_glass_card" android:layout_marginBottom="12dp">
            <ImageView android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/ic_logo_memecio" android:scaleType="centerCrop" android:contentDescription="Logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Memec.io" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Media viewer pribadi" android:textSize="11sp" android:textColor="@color/text_grey" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnModeTampilan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_display" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Mode Tampilan" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnGridColumns" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_grid_w" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Kolom Grid" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnPencarianOnline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_online" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Cari Online" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnBackupLengkap" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_backup" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Backup" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnStatistik" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_stats" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Statistik" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnAutoExit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_timer" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Auto Exit" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnLogCrash" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_crash" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Log Crash" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <ImageButton android:id="@+id/btnPrivacyToggle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:src="@drawable/ic_lock_w" android:background="@drawable/bg_glass_card" android:padding="14dp" android:scaleType="fitCenter" android:clickable="true" android:focusable="true" android:contentDescription="Privasi Screenshot" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btnDevTools" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_settings_w" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Dev Tools" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnDebugMulti" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_margin="4dp" android:orientation="vertical" android:gravity="center" android:padding="10dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_settings_w" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Debug Multi" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
        <TextView android:id="@+id/tvVersiApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="16dp" android:gravity="center" android:text="Memec.io" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_grey" />
        <TextView android:id="@+id/tvVersiBuild" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:layout_marginBottom="16dp" android:gravity="center" android:text="Build: -" android:textSize="9sp" android:textColor="@color/text_grey" />
    </LinearLayout>
</ScrollView>