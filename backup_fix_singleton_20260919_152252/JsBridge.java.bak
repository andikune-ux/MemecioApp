package com.memecio.app.js;

import android.util.Log;

import org.mozilla.javascript.Context;
import org.mozilla.javascript.NativeJavaObject;
import org.mozilla.javascript.Scriptable;
import org.mozilla.javascript.ScriptableObject;

/**
 * Bridge: inject Java helper ke scope Rhino.
 * Pakai Context.javaToJS + verifikasi.
 */
public class JsBridge {

    private static final String TAG = "JsBridge";

    public JsBridge() {}

    public static void inject(Context cx, Scriptable scope) {
        // ===== Inject http =====
        boolean httpOk = false;
        try {
            // Cara 1: Context.javaToJS
            Object wrapped = Context.javaToJS(new JsHttp(), scope);
            scope.put("http", scope, wrapped);
            httpOk = (scope.get("http", scope) != Scriptable.NOT_FOUND);
            Log.d(TAG, "http via javaToJS: " + (httpOk ? "OK" : "FAIL"));
        } catch (Throwable t) {
            Log.e(TAG, "http javaToJS FAIL: " + t.getMessage(), t);
        }

        if (!httpOk) {
            try {
                // Cara 2: NativeJavaObject langsung
                scope.put("http", scope,
                    new NativeJavaObject(scope, new JsHttp(), JsHttp.class));
                httpOk = (scope.get("http", scope) != Scriptable.NOT_FOUND);
                Log.d(TAG, "http via NativeJavaObject: " + (httpOk ? "OK" : "FAIL"));
            } catch (Throwable t) {
                Log.e(TAG, "http NativeJavaObject FAIL: " + t.getMessage(), t);
            }
        }

        if (!httpOk) {
            try {
                // Cara 3: pakai ScriptableObject.putProperty
                ScriptableObject.putProperty(scope, "http", new JsHttp());
                httpOk = (scope.get("http", scope) != Scriptable.NOT_FOUND);
                Log.d(TAG, "http via putProperty: " + (httpOk ? "OK" : "FAIL"));
            } catch (Throwable t) {
                Log.e(TAG, "http putProperty FAIL: " + t.getMessage(), t);
            }
        }

        // ===== Inject console =====
        try {
            Object wrapped = Context.javaToJS(new JsConsole(), scope);
            scope.put("console", scope, wrapped);
            Log.d(TAG, "console via javaToJS: OK");
        } catch (Throwable t) {
            Log.e(TAG, "console FAIL: " + t.getMessage(), t);
        }

        // ===== Marker (untuk verifikasi) =====
        try {
            scope.put("__jsBridgeReady", scope, "1");
        } catch (Throwable t) {
            Log.e(TAG, "marker FAIL: " + t.getMessage(), t);
        }
    }
}
