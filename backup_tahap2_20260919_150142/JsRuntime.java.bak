package com.memecio.app.js;

import android.util.Log;

import org.mozilla.javascript.Context;
import org.mozilla.javascript.Scriptable;

/**
 * Runtime JavaScript untuk Memec.io.
 * Pakai Mozilla Rhino — bisa evaluasi JS di Java/Android.
 *
 * Tahap 1: cuma eval string. Nanti Tahap 2+: helper http, html, dll.
 */
public class JsRuntime {

    private static final String TAG = "JsRuntime";

    public JsRuntime() {}

    /** Evaluasi JavaScript, return Object (String/Integer/Double/Boolean/dll) */
    public static Object eval(String code) {
        Context cx = Context.enter();
        try {
            cx.setOptimizationLevel(-1);  // wajib untuk Android
            cx.setLanguageVersion(Context.VERSION_ES6);
            Scriptable scope = cx.initStandardObjects();
            return cx.evaluateString(scope, code, "script", 1, null);
        } catch (Throwable t) {
            Log.e(TAG, "eval error: " + t.getMessage(), t);
            throw t;
        } finally {
            Context.exit();
        }
    }

    /** Evaluasi JS, return String */
    public static String evalToString(String code) {
        try {
            Object r = eval(code);
            return (r == null) ? "null" : r.toString();
        } catch (Throwable t) {
            return "ERROR: " + t.getClass().getSimpleName() + " - " + t.getMessage();
        }
    }
}
