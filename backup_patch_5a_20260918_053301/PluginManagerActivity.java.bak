package com.memecio.app;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;
import android.view.View;
import android.view.ViewGroup;
import android.widget.ArrayAdapter;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ListView;
import android.widget.TextView;
import android.widget.Toast;

import com.memecio.app.plugin.PluginDescriptor;
import com.memecio.app.plugin.PluginDownloader;
import com.memecio.app.plugin.PluginLoadResult;
import com.memecio.app.plugin.PluginLoader;
import com.memecio.app.plugin.PluginStorage;
import com.memecio.app.plugin.RepositoryManager;
import com.memecio.app.plugin.RepositoryPlugin;
import com.memecio.app.plugin.RepositoryStorage;
import com.memecio.app.plugin.PluginRepository;

import java.io.File;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.List;

public class PluginManagerActivity extends Activity {

    private static final int REQ_PICK_JAR = 12001;

    // Tab
    private TextView tabInstalled, tabRepository;
    private View containerInstalled, containerRepository;
    private boolean showingInstalled = true;

    // Tab 1: Terinstall
    private ListView listPlugins;
    private TextView tvKosong;
    private final List<PluginDescriptor> items = new ArrayList<>();
    private ArrayAdapter<PluginDescriptor> adapter;

    // Tab 2: Repository
    private EditText etRepoUrl;
    private TextView tvRepoStatus;
    private LinearLayout listRepoContainer;
    private LinearLayout listPluginRepoContainer;

    private final Handler ui = new Handler(Looper.getMainLooper());

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        setContentView(R.layout.activity_plugin_manager);

        // ===== Header =====
        View btnBack = findViewById(R.id.btnPluginBack);
        if (btnBack != null) btnBack.setOnClickListener(v -> finish());

        // ===== Tab =====
        tabInstalled = findViewById(R.id.tabInstalled);
        tabRepository = findViewById(R.id.tabRepository);
        containerInstalled = findViewById(R.id.containerInstalled);
        containerRepository = findViewById(R.id.containerRepository);

        if (tabInstalled != null) tabInstalled.setOnClickListener(v -> switchTab(true));
        if (tabRepository != null) tabRepository.setOnClickListener(v -> switchTab(false));

        // ===== Tab 1: Terinstall =====
        listPlugins = findViewById(R.id.listPlugins);
        tvKosong = findViewById(R.id.tvPluginKosong);

        adapter = new ArrayAdapter<PluginDescriptor>(this,
                android.R.layout.simple_list_item_2,
                android.R.id.text1, items) {
            @Override
            public View getView(int position, View convertView, ViewGroup parent) {
                View v = super.getView(position, convertView, parent);
                TextView t1 = v.findViewById(android.R.id.text1);
                TextView t2 = v.findViewById(android.R.id.text2);
                PluginDescriptor d = items.get(position);
                t1.setText(d.name + "  v" + d.version);
                t2.setText(d.author + " — " + d.description);
                return v;
            }
        };
        listPlugins.setAdapter(adapter);

        View btnTambah = findViewById(R.id.btnPluginTambah);
        View btnBukaBrowser = findViewById(R.id.btnBukaBrowser);
        if (btnBukaBrowser != null) btnBukaBrowser.setOnClickListener(v -> {
            startActivity(new Intent(PluginManagerActivity.this, PluginBrowserActivity.class));
        });
        if (btnTambah != null) btnTambah.setOnClickListener(v -> pilihFileJar());

        // ===== Tab 2: Repository =====
        etRepoUrl = findViewById(R.id.etRepoUrl);
        tvRepoStatus = findViewById(R.id.tvRepoStatus);
        listRepoContainer = findViewById(R.id.listRepoContainer);
        listPluginRepoContainer = findViewById(R.id.listPluginRepoContainer);

        View btnRepoMuat = findViewById(R.id.btnRepoMuat);
        if (btnRepoMuat != null) btnRepoMuat.setOnClickListener(v -> muatRepo());

        switchTab(true);
        refresh();
        refreshRepoList();
    }

    // ============================================================
    // TAB
    // ============================================================
    private void switchTab(boolean installed) {
        showingInstalled = installed;
        if (installed) {
            if (containerInstalled != null) containerInstalled.setVisibility(View.VISIBLE);
            if (containerRepository != null) containerRepository.setVisibility(View.GONE);
            if (tabInstalled != null) tabInstalled.setBackgroundResource(R.drawable.bg_glass_button_selected);
            if (tabRepository != null) tabRepository.setBackgroundResource(R.drawable.bg_glass_button);
        } else {
            if (containerInstalled != null) containerInstalled.setVisibility(View.GONE);
            if (containerRepository != null) containerRepository.setVisibility(View.VISIBLE);
            if (tabInstalled != null) tabInstalled.setBackgroundResource(R.drawable.bg_glass_button);
            if (tabRepository != null) tabRepository.setBackgroundResource(R.drawable.bg_glass_button_selected);
        }
    }

    // ============================================================
    // TAB 1: TERINSTALL
    // ============================================================
    private void refresh() {
        items.clear();
        items.addAll(PluginStorage.getInstalledPlugins(this));
        adapter.notifyDataSetChanged();
        if (tvKosong != null) tvKosong.setVisibility(items.isEmpty() ? View.VISIBLE : View.GONE);
        if (listPlugins != null) listPlugins.setVisibility(items.isEmpty() ? View.GONE : View.VISIBLE);
    }

    private void pilihFileJar() {
        Intent i = new Intent(Intent.ACTION_OPEN_DOCUMENT);
        i.setType("*/*");
        i.addCategory(Intent.CATEGORY_OPENABLE);
        try {
            startActivityForResult(i, REQ_PICK_JAR);
        } catch (Exception e) {
            Toast.makeText(this, "Tidak bisa buka file picker", Toast.LENGTH_SHORT).show();
        }
    }

    @Override
    protected void onActivityResult(int req, int res, Intent data) {
        super.onActivityResult(req, res, data);
        if (req != REQ_PICK_JAR || res != RESULT_OK || data == null) return;
        Uri uri = data.getData();
        if (uri == null) return;
        try {
            String nama = "plugin_" + System.currentTimeMillis() + ".jar";
            File target = new File(PluginStorage.getPluginFolder(this), nama);
            InputStream in = getContentResolver().openInputStream(uri);
            FileOutputStream out = new FileOutputStream(target);
            byte[] buf = new byte[8192];
            int n;
            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
            in.close(); out.close();

            PluginLoadResult result = PluginLoader.loadFromJar(this, target);
            if (result.success) {
                Toast.makeText(this, "Plugin " + result.pluginName + " berhasil ditambahkan", Toast.LENGTH_SHORT).show();
                refresh();
            } else {
                Toast.makeText(this, "Gagal load plugin: " + result.errorMessage, Toast.LENGTH_LONG).show();
                target.delete();
            }
        } catch (Exception e) {
            Toast.makeText(this, "Gagal: " + e.getMessage(), Toast.LENGTH_LONG).show();
        }
    }

    // ============================================================
    // TAB 2: REPOSITORY
    // ============================================================
    private void refreshRepoList() {
        if (listRepoContainer == null) return;
        listRepoContainer.removeAllViews();
        List<RepositoryStorage.RepoEntry> repos = RepositoryStorage.getRepos(this);
        if (repos.isEmpty()) {
            TextView tv = new TextView(this);
            tv.setText("Belum ada repo. Masukkan URL repo.json di atas.");
            tv.setTextSize(12f);
            tv.setPadding(24, 12, 24, 12);
            listRepoContainer.addView(tv);
            return;
        }
        for (final RepositoryStorage.RepoEntry e : repos) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.HORIZONTAL);
            row.setPadding(12, 8, 12, 8);

            TextView tvNama = new TextView(this);
            tvNama.setText((e.name == null || e.name.isEmpty()) ? e.url : e.name);
            tvNama.setTextSize(12f);
            tvNama.setLayoutParams(new LinearLayout.LayoutParams(0,
                    LinearLayout.LayoutParams.WRAP_CONTENT, 1f));
            row.addView(tvNama);

            TextView tvMuat = new TextView(this);
            tvMuat.setText("Muat");
            tvMuat.setTextSize(11f);
            tvMuat.setPadding(20, 8, 20, 8);
            tvMuat.setBackgroundResource(R.drawable.bg_glass_button);
            tvMuat.setClickable(true);
            tvMuat.setOnClickListener(v -> {
                if (etRepoUrl != null) etRepoUrl.setText(e.url);
                muatRepo();
            });
            row.addView(tvMuat);

            TextView tvHapus = new TextView(this);
            tvHapus.setText("Hapus");
            tvHapus.setTextSize(11f);
            tvHapus.setPadding(20, 8, 20, 8);
            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT);
            lp.setMargins(6, 0, 0, 0);
            tvHapus.setLayoutParams(lp);
            tvHapus.setBackgroundResource(R.drawable.bg_glass_button);
            tvHapus.setClickable(true);
            tvHapus.setOnClickListener(v -> {
                RepositoryStorage.removeRepo(PluginManagerActivity.this, e.url);
                refreshRepoList();
            });
            row.addView(tvHapus);

            listRepoContainer.addView(row);
        }
    }

    private void muatRepo() {
        if (etRepoUrl == null) return;
        final String url = etRepoUrl.getText().toString().trim();
        if (url.isEmpty()) {
            Toast.makeText(this, "Masukkan URL repo.json dulu", Toast.LENGTH_SHORT).show();
            return;
        }
        if (!url.startsWith("http://") && !url.startsWith("https://")) {
            Toast.makeText(this, "URL harus http:// atau https://", Toast.LENGTH_SHORT).show();
            return;
        }

        if (tvRepoStatus != null) tvRepoStatus.setText("Memuat...");
        if (listPluginRepoContainer != null) listPluginRepoContainer.removeAllViews();

        new Thread(() -> {
            final PluginRepository repo = RepositoryManager.fetch(url);
            ui.post(() -> {
                if (repo == null || !repo.isValid()) {
                    if (tvRepoStatus != null) tvRepoStatus.setText("Gagal muat / repo kosong");
                    Toast.makeText(PluginManagerActivity.this, "Gagal muat repo", Toast.LENGTH_LONG).show();
                    return;
                }
                RepositoryStorage.addRepo(PluginManagerActivity.this, url, repo.name);
                refreshRepoList();

                if (tvRepoStatus != null) {
                    tvRepoStatus.setText("Repo: " + repo.name + " (" + repo.pluginCount() + " plugin)");
                }
                renderPluginRepoList(repo.plugins);
            });
        }).start();
    }

    private void renderPluginRepoList(List<RepositoryPlugin> plugins) {
        if (listPluginRepoContainer == null) return;
        listPluginRepoContainer.removeAllViews();
        for (final RepositoryPlugin p : plugins) {
            LinearLayout card = new LinearLayout(this);
            card.setOrientation(LinearLayout.VERTICAL);
            card.setPadding(16, 12, 16, 12);
            card.setBackgroundResource(R.drawable.bg_glass_card);

            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.MATCH_PARENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT);
            lp.setMargins(0, 6, 0, 6);
            card.setLayoutParams(lp);

            TextView tvTitle = new TextView(this);
            tvTitle.setText(p.name + "  v" + p.version);
            tvTitle.setTextSize(14f);
            tvTitle.setTypeface(null, android.graphics.Typeface.BOLD);
            card.addView(tvTitle);

            TextView tvAuthor = new TextView(this);
            tvAuthor.setText(p.author + " — " + p.description);
            tvAuthor.setTextSize(11f);
            card.addView(tvAuthor);

            TextView tvInstall = new TextView(this);
            tvInstall.setText("Install");
            tvInstall.setTextSize(12f);
            tvInstall.setPadding(24, 8, 24, 8);
            LinearLayout.LayoutParams lp2 = new LinearLayout.LayoutParams(
                    LinearLayout.LayoutParams.WRAP_CONTENT,
                    LinearLayout.LayoutParams.WRAP_CONTENT);
            lp2.setMargins(0, 8, 0, 0);
            tvInstall.setLayoutParams(lp2);
            tvInstall.setBackgroundResource(R.drawable.bg_glass_button_selected);
            tvInstall.setClickable(true);
            tvInstall.setOnClickListener(v -> konfirmasiInstall(p));
            card.addView(tvInstall);

            listPluginRepoContainer.addView(card);
        }
    }

    private void konfirmasiInstall(final RepositoryPlugin p) {
        new AlertDialog.Builder(this)
            .setTitle("Install Plugin")
            .setMessage("Install " + p.name + " v" + p.version + "?\n\nDownload dari:\n" + p.downloadUrl)
            .setNegativeButton("Batal", null)
            .setPositiveButton("Install", (d, w) -> downloadInstall(p))
            .show();
    }

    private void downloadInstall(final RepositoryPlugin p) {
        Toast.makeText(this, "Mengunduh " + p.name + "...", Toast.LENGTH_SHORT).show();
        new Thread(() -> {
            final PluginLoadResult result = PluginDownloader.download(this, p);
            ui.post(() -> {
                if (result.success) {
                    Toast.makeText(this, "Plugin " + result.pluginName + " terinstall", Toast.LENGTH_LONG).show();
                    refresh();
                } else {
                    Toast.makeText(this, "Gagal install: " + result.errorMessage, Toast.LENGTH_LONG).show();
                }
            });
        }).start();
    }
}
