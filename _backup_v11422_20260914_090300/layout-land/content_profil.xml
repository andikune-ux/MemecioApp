<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/bg_cream" android:padding="12dp">
    <LinearLayout android:layout_width="180dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/bg_glass_card" android:layout_marginEnd="8dp">
        <TextView android:layout_width="60dp" android:layout_height="60dp" android:text="io" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center" android:background="@drawable/bg_glass_button_selected" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Memec.io" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Media viewer pribadi" android:textSize="11sp" android:textColor="@color/text_grey" />
        <TextView android:id="@+id/tvVersiApp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Memec.io" android:textSize="11sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_grey" />
        <TextView android:id="@+id/tvVersiBuild" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Build: -" android:textSize="9sp" android:textColor="@color/text_grey" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnModeTampilan" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_display" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mode Tampilan" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnZoomUI" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_zoom" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Ukuran UI" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnGridColumns" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_grid_w" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Kolom Grid" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnPencarianOnline" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_online" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Cari Online" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnDataSaver" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_datasave" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Hemat Data" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnBackupLengkap" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_backup" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Backup" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnStatistik" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_stats" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Statistik" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/btnAutoExit" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_timer" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Auto Exit" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnLogCrash" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_crash" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Log Crash" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <LinearLayout android:id="@+id/btnDevTools" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:padding="6dp" android:visibility="gone" android:clickable="true" android:focusable="true" android:background="@drawable/bg_glass_card">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/ic_settings_w" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Dev Tools" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_dark" android:gravity="center" android:maxLines="2" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>